{
  "name": "crm-optica",
  "version": "1.0.0",
  "description": "Sistema CRM para Óptica con integración omnicanal Zernio en Next.js y Vercel",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix cliente run dev",
    "build": "npm --prefix cliente run build",
    "start": "npm --prefix cliente run start",
    "probar:conexion": "node --env-file=.env scripts/probar_conexion_zernio.mjs",
    "webhook:listar": "node --env-file=.env scripts/gestor_webhook.mjs",
    "webhook:registrar": "node --env-file=.env scripts/gestor_webhook.mjs --url",
    "webhook:probar": "node --env-file=.env scripts/gestor_webhook.mjs --probar"
  },
  "keywords": [
    "crm",
    "optica",
    "zernio",
    "whatsapp"
  ],
  "author": "",
  "license": "ISC"
}
