# Credenciales y Configuración de Zernio (https://zernio.com)
ZERNIO_API_KEY=sk_tu_clave_de_zernio_aqui
ZERNIO_API_BASE=https://zernio.com/api/v1
ZERNIO_PROFILE_ID=

# Secreto para firma de webhooks (mínimo 32 caracteres generados aleatoriamente)
ZERNIO_WEBHOOK_SECRET=secreto_seguro_para_firmar_webhooks_32_caracteres_min

# URL pública de tu aplicación (ejemplo: https://mi-optica.com o túnel ngrok)
URL_BASE_APLICACION=https://tu-dominio.com

# Puerto del servidor local
PUERTO=3000
